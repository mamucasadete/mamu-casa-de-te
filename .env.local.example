# ============================================================
# Sanity CMS - Environment Variables
# ============================================================
# Copiar este archivo a `.env.local` y completar con los valores reales.
#
# ¿Dónde conseguir los valores?
#   1. Entrar a https://www.sanity.io/manage
#   2. Seleccionar el proyecto "MAMU Casa de Té"
#   3. Settings → API:
#      - Project ID  → NEXT_PUBLIC_SANITY_PROJECT_ID y SANITY_STUDIO_PROJECT_ID
#      - Dataset     → NEXT_PUBLIC_SANITY_DATASET y SANITY_STUDIO_DATASET
#      - Tokens → Add API Token → nombre "nextjs" → permisos "Editor" → copiar
#        → SANITY_API_TOKEN
# ============================================================

# === Expuestas al navegador (read-only) ===
NEXT_PUBLIC_SANITY_PROJECT_ID=tu_project_id_aqui
NEXT_PUBLIC_SANITY_DATASET=production

# === Solo servidor (escritura, NUNCA exponer al navegador) ===
SANITY_API_TOKEN=tu_token_aqui

# === Sanity Studio (panel admin) ===
SANITY_STUDIO_PROJECT_ID=tu_project_id_aqui
SANITY_STUDIO_DATASET=production
